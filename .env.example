# Plug's deterministic core needs no environment variables.
# Copy this file to .env.local only for the optional features you enable.

# Jev typed judgments and cross-checks.
PLUG_JUDGE_PROVIDER=typesafe
PLUG_JUDGE_MODEL=
TYPESAFE_API_KEY=

# Completion-backed fact/request-sample drafting.
# Use "openai" and OPENAI_API_KEY instead when appropriate.
PLUG_DRAFT_PROVIDER=anthropic
PLUG_DRAFT_MODEL=
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional critic overrides. When omitted, review reuses the draft provider/model.
# PLUG_REVIEW_PROVIDER=anthropic
# PLUG_REVIEW_MODEL=

# Public hosted-playground deployment only.
# APP_ORIGIN=https://plug.example.com
# PORT=3000
# TRUST_PROXY_HOPS=0
# RELEASE_COMMIT=

# Integration credentials are project-specific. A binding such as
# Authorization: ${env:PARTNER_API_TOKEN} requires that exact variable at execution.
# PARTNER_API_TOKEN=
